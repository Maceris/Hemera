package unicode

/*
 * UTF-8, grapheme clusters and the columns text takes on a terminal, from the Unicode Character Database's tables
 * (tables.hsc, generated by _generator/generate.py).
 *
 * A grapheme cluster is what a reader takes for one character: a letter and its accents, a Hangul syllable, an emoji
 * with its modifiers, a flag, as UAX #29 defines extended grapheme clusters. A terminal gives each cluster one or two
 * columns, so text is measured a cluster at a time:
 *
 *     at : usize = 0
 *     loop {
 *         end :: unicode.grapheme_end(bytes, at)
 *         columns += unicode.grapheme_width(bytes[at..<end])
 *         at = end
 *     }
 *     while at < bytes.count
 *
 * Bytes that aren't UTF-8 are each a cluster of their own, one column wide, as a terminal shows them with U+FFFD.
 */

// The code point shown in place of bytes that aren't UTF-8.
REPLACEMENT : u32 : 0xfffd

// The largest code point.
MAX_CODE_POINT : u32 : 0x10ffff

// A code point's Grapheme_Cluster_Break property (UAX #29), as the tables number it.
GraphemeBreak :: enum #backed_by(u8) {
    Other = 0,
    CR = 1,
    LF = 2,
    Control = 3,
    Extend = 4,
    ZWJ = 5,
    RegionalIndicator = 6,
    Prepend = 7,
    SpacingMark = 8,
    L = 9,
    V = 10,
    T = 11,
    LV = 12,
    LVT = 13,
}

// A code point's Indic_Conjunct_Break property, which joins consonants across a virama (UAX #29's GB9c).
ConjunctBreak :: enum #backed_by(u8) {
    None = 0,
    Linker = 1,
    Consonant = 2,
    Extend = 3,
}

EXTENDED_PICTOGRAPHIC : u16 : 1 << 4
CONJUNCT_SHIFT : u16 : 5
WIDTH_SHIFT : u16 : 7
DEFAULT_IGNORABLE : u16 : 1 << 9

/*
 * The code point at at in bytes, and how many bytes it takes; length 0 where the bytes there aren't UTF-8 (cut short,
 * overlong, a surrogate or past U+10FFFF) or at is past the end.
 */
decode :: fn(bytes: u8[], at: usize) -> (point: u32, length: usize) {
    if at >= bytes.count {
        return 0, 0
    }
    first :: cast[u32](bytes[at])
    length : usize = 0
    point := cast[u32](0)
    smallest := cast[u32](0)
    if first < 0x80 {
        return first, 1
    }
    else if first & 0xe0 == 0xc0 {
        length = 2
        point = first & 0x1f
        smallest = 0x80
    }
    else if first & 0xf0 == 0xe0 {
        length = 3
        point = first & 0x0f
        smallest = 0x800
    }
    else if first & 0xf8 == 0xf0 {
        length = 4
        point = first & 0x07
        smallest = 0x10000
    }
    else {
        return 0, 0
    }
    if length > bytes.count - at {
        return 0, 0
    }
    for i in 1..<length {
        if at + i >= bytes.count {
            return 0, 0
        }
        next :: cast[u32](bytes[at + i])
        if next & 0xc0 != 0x80 {
            return 0, 0
        }
        point = (point << 6) | (next & 0x3f)
    }
    if point < smallest || point > MAX_CODE_POINT || (point >= 0xd800 && point <= 0xdfff) {
        return 0, 0
    }
    return point, length
}

// point as UTF-8 at the start of into: how many bytes it took, 0 if it isn't a code point or into has no room.
encode :: fn(point: u32, into: mut u8[]) -> usize {
    if point > MAX_CODE_POINT || (point >= 0xd800 && point <= 0xdfff) {
        return 0
    }
    length :: if point < 0x80 { cast[usize](1) } else if point < 0x800 { cast[usize](2) } else if point < 0x10000 { cast[usize](3) } else { cast[usize](4) }
    if into.count < length {
        return 0
    }
    if length == 1 {
        into[0] = cast[u8](point)
        return 1
    }
    // The lead byte's marker: 110, 1110 or 11110, above the bits it holds
    lead :: if length == 2 { cast[u32](0xc0) } else if length == 3 { cast[u32](0xe0) } else { cast[u32](0xf0) }
    for i in 0..<length {
        shift :: cast[u32](6 * (length - 1 - i))
        bits :: (point >> shift) & 0x3f
        into[i] = cast[u8](if i == 0 { lead | (point >> shift) } else { 0x80 | bits })
    }
    return length
}

// The tables' properties of point: the run it's in, found by binary search.
properties :: fn(point: u32) -> u16 {
    low : usize = 0
    high : usize = RUN_STARTS.count
    loop {
        middle :: low + (high - low) / 2
        if middle < RUN_STARTS.count && RUN_STARTS[middle] <= point {
            low = middle
        }
        else {
            high = middle
        }
    }
    while high - low > 1
    return if low < RUN_PROPERTIES.count { RUN_PROPERTIES[low] } else { cast[u16](0) }
}

grapheme_break :: fn(point: u32) -> GraphemeBreak {
    return cast[GraphemeBreak](cast[u8](properties(point) & 0xf))
}

conjunct_break :: fn(point: u32) -> ConjunctBreak {
    return cast[ConjunctBreak](cast[u8]((properties(point) >> CONJUNCT_SHIFT) & 3))
}

// Whether point is Extended_Pictographic: an emoji, or a symbol that may be one.
is_extended_pictographic :: fn(point: u32) -> bool {
    return properties(point) & EXTENDED_PICTOGRAPHIC != 0
}

/*
 * Whether point is a Default_Ignorable_Code_Point, which shows nothing where it isn't supported: joiners, variation
 * selectors, the bidirectional controls, soft hyphens, tags and the like. UTS #39 counts them as invisible.
 */
is_default_ignorable :: fn(point: u32) -> bool {
    return properties(point) & DEFAULT_IGNORABLE != 0
}

// Whether point is one of the bidirectional formatting characters (UAX #9's explicit formatting, and the marks).
is_bidi_control :: fn(point: u32) -> bool {
    return point == 0x061c || point == 0x200e || point == 0x200f || (point >= 0x202a && point <= 0x202e)
        || (point >= 0x2066 && point <= 0x2069)
}

// Whether point is a C0 or C1 control, or DEL.
is_control :: fn(point: u32) -> bool {
    return point < 0x20 || (point >= 0x7f && point <= 0x9f)
}

/*
 * The columns point takes on its own: 2 for East Asian wide and fullwidth ones, 0 for those that combine with the one
 * before or show nothing (marks, formats, controls, default ignorables, Hangul's medial vowels and final consonants),
 * and 1 for the rest, ambiguous ones included.
 */
width :: fn(point: u32) -> usize {
    return cast[usize]((properties(point) >> WIDTH_SHIFT) & 3)
}

/*
 * Where the grapheme cluster that starts at at in bytes ends: the index after its last byte, bytes.count at most. A byte
 * that isn't UTF-8 is a cluster of its own. at at or past the end gives bytes.count.
 */
grapheme_end :: fn(bytes: u8[], at: usize) -> usize {
    if at >= bytes.count {
        return bytes.count
    }
    first, first_length :: decode(bytes, at)
    if first_length == 0 {
        return at + 1
    }
    before := grapheme_break(first)
    // How many regional indicators have been paired so far (GB12, GB13)
    indicators : usize = if before == .RegionalIndicator { cast[usize](1) } else { cast[usize](0) }
    // An Extended_Pictographic then only Extend (GB11), and whether a ZWJ just followed one
    pictographic := is_extended_pictographic(first)
    joined_pictographic := false
    // A conjunct's consonant then only Extend and Linker (GB9c), and whether a Linker is among them
    consonant := conjunct_break(first) == .Consonant
    linked := false
    end := at + first_length
    loop {
        if end >= bytes.count {
            break
        }
        point, length :: decode(bytes, end)
        if length == 0 {
            break
        }
        after :: grapheme_break(point)
        if !joins(before, after, point, indicators, joined_pictographic, consonant && linked) {
            break
        }
        // The state for the next pair, from this one
        conjunct :: conjunct_break(point)
        joined_pictographic = after == .ZWJ && pictographic
        pictographic = is_extended_pictographic(point) || (pictographic && after == .Extend)
        if conjunct == .Consonant {
            consonant = true
            linked = false
        }
        else if consonant && conjunct == .Linker {
            linked = true
        }
        else if !(consonant && conjunct == .Extend) {
            consonant = false
            linked = false
        }
        indicators = if after == .RegionalIndicator { indicators + 1 } else { cast[usize](0) }
        before = after
        end += length
    }
    return end
}

/*
 * Whether there's no break between a code point whose property is before and the next, point, whose property is after
 * (UAX #29's rules GB3 to GB13): indicators is how many regional indicators run up to the first, pictographic_joined
 * whether the first is a ZWJ after an Extended_Pictographic and Extends, and conjunct_linked whether a conjunct's
 * consonant and a linker come before, with only Extends and Linkers since.
 */
joins :: fn(before: GraphemeBreak, after: GraphemeBreak, point: u32, indicators: usize, pictographic_joined: bool,
    conjunct_linked: bool) -> bool {
    // GB3 to GB5
    if before == .CR && after == .LF {
        return true
    }
    if before == .CR || before == .LF || before == .Control || after == .CR || after == .LF || after == .Control {
        return false
    }
    // GB6 to GB8, Hangul syllables
    if before == .L && (after == .L || after == .V || after == .LV || after == .LVT) {
        return true
    }
    if (before == .LV || before == .V) && (after == .V || after == .T) {
        return true
    }
    if (before == .LVT || before == .T) && after == .T {
        return true
    }
    // GB9 to GB9b
    if after == .Extend || after == .ZWJ || after == .SpacingMark || before == .Prepend {
        return true
    }
    // GB9c, a conjunct
    if conjunct_linked && conjunct_break(point) == .Consonant {
        return true
    }
    // GB11, an emoji ZWJ sequence
    if pictographic_joined && is_extended_pictographic(point) {
        return true
    }
    // GB12 and GB13, flags in pairs
    if before == .RegionalIndicator && after == .RegionalIndicator {
        return indicators % 2 == 1
    }
    return false
}

/*
 * The columns one grapheme cluster takes: the widest of its code points, at most 2; 2 for an emoji with emoji
 * presentation asked for (U+FE0F) and for a flag, and 1 for an emoji with text presentation asked for (U+FE0E). Bytes
 * that aren't UTF-8 take 1, as U+FFFD would.
 */
grapheme_width :: fn(cluster: u8[]) -> usize {
    first, first_length :: decode(cluster, 0)
    if first_length == 0 {
        return if cluster.count == 0 { cast[usize](0) } else { cast[usize](1) }
    }
    widest := width(first)
    indicators : usize = 0
    at : usize = 0
    loop {
        point, length :: decode(cluster, at)
        if length == 0 {
            break
        }
        if point == 0xfe0f && is_extended_pictographic(first) {
            return 2
        }
        if point == 0xfe0e && is_extended_pictographic(first) {
            return 1
        }
        if grapheme_break(point) == .RegionalIndicator {
            indicators += 1
        }
        columns :: width(point)
        if columns > widest {
            widest = columns
        }
        at += length
    }
    while at < cluster.count
    if indicators >= 2 {
        return 2
    }
    return if widest > 2 { cast[usize](2) } else { widest }
}

// The columns text takes, a grapheme cluster at a time.
text_width :: fn(text: u8[]) -> usize {
    columns : usize = 0
    at : usize = 0
    loop {
        end :: grapheme_end(text, at)
        if end <= at || end > text.count {
            break
        }
        columns += grapheme_width(text[at..<end])
        at = end
    }
    while at < text.count
    return columns
}
