// Finds each of the device's commands the loader doesn't export, leaving those it doesn't have null
load_device_procs :: fn(device: VkDevice, procs: ptr[mut VulkanDeviceProcs]) {
    procs.vkAcquirePerformanceConfigurationINTEL = bit_cast[PFN_vkAcquirePerformanceConfigurationINTEL?](vkGetDeviceProcAddr(device, "vkAcquirePerformanceConfigurationINTEL"))
    procs.vkAcquireProfilingLockKHR = bit_cast[PFN_vkAcquireProfilingLockKHR?](vkGetDeviceProcAddr(device, "vkAcquireProfilingLockKHR"))
    procs.vkBindAccelerationStructureMemoryNV = bit_cast[PFN_vkBindAccelerationStructureMemoryNV?](vkGetDeviceProcAddr(device, "vkBindAccelerationStructureMemoryNV"))
    procs.vkBindBufferMemory2KHR = bit_cast[PFN_vkBindBufferMemory2KHR?](vkGetDeviceProcAddr(device, "vkBindBufferMemory2KHR"))
    procs.vkBindImageMemory2KHR = bit_cast[PFN_vkBindImageMemory2KHR?](vkGetDeviceProcAddr(device, "vkBindImageMemory2KHR"))
    procs.vkBindOpticalFlowSessionImageNV = bit_cast[PFN_vkBindOpticalFlowSessionImageNV?](vkGetDeviceProcAddr(device, "vkBindOpticalFlowSessionImageNV"))
    procs.vkBindVideoSessionMemoryKHR = bit_cast[PFN_vkBindVideoSessionMemoryKHR?](vkGetDeviceProcAddr(device, "vkBindVideoSessionMemoryKHR"))
    procs.vkBuildAccelerationStructuresKHR = bit_cast[PFN_vkBuildAccelerationStructuresKHR?](vkGetDeviceProcAddr(device, "vkBuildAccelerationStructuresKHR"))
    procs.vkBuildMicromapsEXT = bit_cast[PFN_vkBuildMicromapsEXT?](vkGetDeviceProcAddr(device, "vkBuildMicromapsEXT"))
    procs.vkCmdBeginConditionalRenderingEXT = bit_cast[PFN_vkCmdBeginConditionalRenderingEXT?](vkGetDeviceProcAddr(device, "vkCmdBeginConditionalRenderingEXT"))
    procs.vkCmdBeginDebugUtilsLabelEXT = bit_cast[PFN_vkCmdBeginDebugUtilsLabelEXT?](vkGetDeviceProcAddr(device, "vkCmdBeginDebugUtilsLabelEXT"))
    procs.vkCmdBeginQueryIndexedEXT = bit_cast[PFN_vkCmdBeginQueryIndexedEXT?](vkGetDeviceProcAddr(device, "vkCmdBeginQueryIndexedEXT"))
    procs.vkCmdBeginRenderPass2KHR = bit_cast[PFN_vkCmdBeginRenderPass2KHR?](vkGetDeviceProcAddr(device, "vkCmdBeginRenderPass2KHR"))
    procs.vkCmdBeginRenderingKHR = bit_cast[PFN_vkCmdBeginRenderingKHR?](vkGetDeviceProcAddr(device, "vkCmdBeginRenderingKHR"))
    procs.vkCmdBeginTransformFeedbackEXT = bit_cast[PFN_vkCmdBeginTransformFeedbackEXT?](vkGetDeviceProcAddr(device, "vkCmdBeginTransformFeedbackEXT"))
    procs.vkCmdBeginVideoCodingKHR = bit_cast[PFN_vkCmdBeginVideoCodingKHR?](vkGetDeviceProcAddr(device, "vkCmdBeginVideoCodingKHR"))
    procs.vkCmdBindDescriptorBufferEmbeddedSamplersEXT = bit_cast[PFN_vkCmdBindDescriptorBufferEmbeddedSamplersEXT?](vkGetDeviceProcAddr(device, "vkCmdBindDescriptorBufferEmbeddedSamplersEXT"))
    procs.vkCmdBindDescriptorBuffersEXT = bit_cast[PFN_vkCmdBindDescriptorBuffersEXT?](vkGetDeviceProcAddr(device, "vkCmdBindDescriptorBuffersEXT"))
    procs.vkCmdBindIndexBuffer2KHR = bit_cast[PFN_vkCmdBindIndexBuffer2KHR?](vkGetDeviceProcAddr(device, "vkCmdBindIndexBuffer2KHR"))
    procs.vkCmdBindInvocationMaskHUAWEI = bit_cast[PFN_vkCmdBindInvocationMaskHUAWEI?](vkGetDeviceProcAddr(device, "vkCmdBindInvocationMaskHUAWEI"))
