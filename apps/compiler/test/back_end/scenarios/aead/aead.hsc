/*
 * std/crypto's authenticated encryption: ChaCha20-Poly1305 (RFC 8439's example and more) and AES-256-GCM
 * (NIST's test case 16 and more, with AES-NI and PCLMULQDQ and without), against values from
 * Python's cryptography package, over empty, short, block-sized and longer messages and associated data. A
 * flipped bit in the ciphertext, tag or associated data is refused, and nothing is written. main returns 42
 * if they all worked.
 */
package aead_test

import compiler from "base"
import crypto from "std"

// hex's bytes into into, how many there were
decode :: fn(hex: string, into: ptr[mut u8[1200]]) -> usize {
    for c, j in hex {
        nibble := cast[u8](c) - cast[u8]('0')
        if c >= 'a' {
            nibble = cast[u8](c) - cast[u8]('a') + 10
        }
        into[(j / 2) % 1200] = into[(j / 2) % 1200] * 16 + nibble
    }
    return (hex.count / 2) % 1201
}

key_of #constant_time :: fn(hex: string) -> crypto.Key256 {
    bytes : u8[1200]
    _ = decode(hex, &bytes)
    key : crypto.Key256
    for i in 0..<32 {
        key[i] = bytes[i]
    }
    return key
}

nonce_of :: fn(hex: string) -> crypto.Nonce96 {
    bytes : u8[1200]
    _ = decode(hex, &bytes)
    nonce : crypto.Nonce96
    for i in 0..<12 {
        nonce[i] = bytes[i]
    }
    return nonce
}

Kind :: enum {
    CHACHA,
    AES,
    AES_SOFTWARE,
}

seal #constant_time :: fn(kind: Kind, key: ptr[crypto.Key256], nonce: ptr[crypto.Nonce96], plaintext: crypto.SecretByte[], associated: u8[],
    ciphertext: mut u8[], tag: ptr[mut crypto.Tag128]) -> bool {

    if kind == .CHACHA {
        return crypto.chacha20_poly1305_seal(key, nonce, plaintext, associated, ciphertext, tag)
    }
    return crypto.aes256_gcm_seal_with(key, nonce, plaintext, associated, ciphertext, tag, kind == .AES && crypto.aes_hardware())
}

open #constant_time :: fn(kind: Kind, key: ptr[crypto.Key256], nonce: ptr[crypto.Nonce96], ciphertext: u8[], associated: u8[],
    tag: ptr[crypto.Tag128], plaintext: mut crypto.SecretByte[]) -> bool {

    if kind == .CHACHA {
        return crypto.chacha20_poly1305_open(key, nonce, ciphertext, associated, tag, plaintext)
    }
    return crypto.aes256_gcm_open_with(key, nonce, ciphertext, associated, tag, plaintext, kind == .AES && crypto.aes_hardware())
}

/*
 * One case: sealed, the ciphertext and tag compared with what's expected, opened again, and refused with
 * a bit flipped in the ciphertext, the tag, and the associated data. 0, or what went wrong.
 */
check #constant_time :: fn(kind: Kind, key_hex: string, nonce_hex: string, associated_hex: string, plaintext_hex: string,
    expected_hex: string) -> int {

    key := key_of(key_hex)
    nonce := nonce_of(nonce_hex)
    associated : u8[1200]
    associated_count := decode(associated_hex, &associated) % 1201
    plain_bytes : u8[1200]
    count := decode(plaintext_hex, &plain_bytes) % 1201
    expected : u8[1200]
    _ = decode(expected_hex, &expected)
    plaintext := crypto.as_secret(plain_bytes[0..<count])
    ciphertext : u8[1200]
    tag : crypto.Tag128
    if !seal(kind, &key, &nonce, plaintext, associated[0..<associated_count], ciphertext[0..<count], &tag) {
        return 1
    }
    for i in 0..<count {
        if ciphertext[i] != expected[i] {
            return 2
        }
    }
    for i in 0..<16 {
        if tag[i] != expected[(count + cast[usize](i)) % 1200] {
            return 3
        }
    }
    opened : crypto.SecretByte[1200]
    if !open(kind, &key, &nonce, ciphertext[0..<count], associated[0..<associated_count], &tag, opened[0..<count]) {
        return 4
    }
    for i in 0..<count {
        if compiler.declassify(opened[i]) != plain_bytes[i] {
            return 5
        }
    }
    // Refused, with nothing written, when anything is changed
    untouched : crypto.SecretByte[1200]
    tag[0] = tag[0] ~ 1
    if open(kind, &key, &nonce, ciphertext[0..<count], associated[0..<associated_count], &tag, untouched[0..<count]) {
        return 6
    }
    tag[0] = tag[0] ~ 1
    if count > 0 {
        ciphertext[count - 1] = ciphertext[count - 1] ~ 0x80
        if open(kind, &key, &nonce, ciphertext[0..<count], associated[0..<associated_count], &tag, untouched[0..<count]) {
            return 7
        }
        ciphertext[count - 1] = ciphertext[count - 1] ~ 0x80
    }
    if associated_count > 0 {
        associated[0] = associated[0] ~ 4
        if open(kind, &key, &nonce, ciphertext[0..<count], associated[0..<associated_count], &tag, untouched[0..<count]) {
            return 8
        }
    }
    for i in 0..<count {
        if compiler.declassify(untouched[i]) != 0 {
            return 9
        }
    }
    return 0
}

main :: fn() -> int {
    result_1 := check(.CHACHA, "808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f", "070000004041424344454647", "50515253c0c1c2c3c4c5c6c7", "4c616469657320616e642047656e746c656d656e206f662074686520636c617373206f66202739393a204966204920636f756c64206f6666657220796f75206f6e6c79206f6e652074697020666f7220746865206675747572652c2073756e73637265656e20776f756c642062652069742e", "d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b61161ae10b594f09e26a7e902ecbd0600691")
    if result_1 != 0 {
        return 1 * 10 + result_1
    }
    result_2 := check(.CHACHA, "010e1b2835424f5c697683909daab7c4d1deebf805121f2c394653606d7a8794", "000102030405060708090a0b", "", "", "23cccb17c8344f6348f1aa1d557ba5de")
    if result_2 != 0 {
        return 2 * 10 + result_2
    }
    result_3 := check(.AES, "010e1b2835424f5c697683909daab7c4d1deebf805121f2c394653606d7a8794", "000102030405060708090a0b", "", "", "8b22a00298e3618e9dcade66bd249ad7")
    if result_3 != 0 {
        return 3 * 10 + result_3
    }
    result_4 := check(.AES_SOFTWARE, "010e1b2835424f5c697683909daab7c4d1deebf805121f2c394653606d7a8794", "000102030405060708090a0b", "", "", "8b22a00298e3618e9dcade66bd249ad7")
    if result_4 != 0 {
        return 4 * 10 + result_4
    }
    result_5 := check(.CHACHA, "010e1b2835424f5c697683909daab7c4d1deebf805121f2c394653606d7a8794", "000102030405060708090a0b", "030a11181f", "03", "d3a3d48fd4cbc21b7014ec6626b277d6eb")
    if result_5 != 0 {
        return 5 * 10 + result_5
    }
    result_6 := check(.AES, "010e1b2835424f5c697683909daab7c4d1deebf805121f2c394653606d7a8794", "000102030405060708090a0b", "030a11181f", "03", "493b1fdc4b51d7a864a2c418611fcdd7f2")
    if result_6 != 0 {
        return 6 * 10 + result_6
    }
    result_7 := check(.AES_SOFTWARE, "010e1b2835424f5c697683909daab7c4d1deebf805121f2c394653606d7a8794", "000102030405060708090a0b", "030a11181f", "03", "493b1fdc4b51d7a864a2c418611fcdd7f2")
    if result_7 != 0 {
        return 7 * 10 + result_7
    }
    result_8 := check(.CHACHA, "010e1b2835424f5c697683909daab7c4d1deebf805121f2c394653606d7a8794", "000102030405060708090a0b", "030a11181f262d343b424950575e656c", "030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dce3eaf1f8ff060d141b222930373e454c535a61686f767d848b9299a0a7aeb5", "d338f160103cae6f1fc19d4f76ed4a0c4b8e582c40c1edac8a194e8dc1c412ee519d3edc98b0aa5f91721b6c33d659de1a351bdb3328073f078fdc69e09bcec39de98d106ad651e577c5c1fcbc9348")
    if result_8 != 0 {
        return 8 * 10 + result_8
    }
    result_9 := check(.AES, "010e1b2835424f5c697683909daab7c4d1deebf805121f2c394653606d7a8794", "000102030405060708090a0b", "030a11181f262d343b424950575e656c", "030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dce3eaf1f8ff060d141b222930373e454c535a61686f767d848b9299a0a7aeb5", "49c966e1514d2e5df41c40e87366f277a139c28c47c77aaa762d3b39d108a8c49f44dae5dc743b78d2d15628ce01a2f1ec60954dbf9c9272911e48faa8c2fd5d021ec1f316771bf89c47bcb04292d8")
    if result_9 != 0 {
        return 9 * 10 + result_9
    }
    result_10 := check(.AES_SOFTWARE, "010e1b2835424f5c697683909daab7c4d1deebf805121f2c394653606d7a8794", "000102030405060708090a0b", "030a11181f262d343b424950575e656c", "030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dce3eaf1f8ff060d141b222930373e454c535a61686f767d848b9299a0a7aeb5", "49c966e1514d2e5df41c40e87366f277a139c28c47c77aaa762d3b39d108a8c49f44dae5dc743b78d2d15628ce01a2f1ec60954dbf9c9272911e48faa8c2fd5d021ec1f316771bf89c47bcb04292d8")
    if result_10 != 0 {
        return 10 * 10 + result_10
    }
    result_11 := check(.CHACHA, "010e1b2835424f5c697683909daab7c4d1deebf805121f2c394653606d7a8794", "000102030405060708090a0b", "030a11181f262d343b424950575e656c73", "030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dce3eaf1f8ff060d141b222930373e454c535a61686f767d848b9299a0a7aeb5bc", "d338f160103cae6f1fc19d4f76ed4a0c4b8e582c40c1edac8a194e8dc1c412ee519d3edc98b0aa5f91721b6c33d659de1a351bdb3328073f078fdc69e09bceb2f15f932c6d972e444b2948c4f2038b48")
    if result_11 != 0 {
        return 11 * 10 + result_11
    }
    result_12 := check(.AES, "010e1b2835424f5c697683909daab7c4d1deebf805121f2c394653606d7a8794", "000102030405060708090a0b", "030a11181f262d343b424950575e656c73", "030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dce3eaf1f8ff060d141b222930373e454c535a61686f767d848b9299a0a7aeb5bc", "49c966e1514d2e5df41c40e87366f277a139c28c47c77aaa762d3b39d108a8c49f44dae5dc743b78d2d15628ce01a2f1ec60954dbf9c9272911e48faa8c2fd96d3523c0e1a6a0d0a39df0e9accde9690")
    if result_12 != 0 {
        return 12 * 10 + result_12
    }
    result_13 := check(.AES_SOFTWARE, "010e1b2835424f5c697683909daab7c4d1deebf805121f2c394653606d7a8794", "000102030405060708090a0b", "030a11181f262d343b424950575e656c73", "030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dce3eaf1f8ff060d141b222930373e454c535a61686f767d848b9299a0a7aeb5bc", "49c966e1514d2e5df41c40e87366f277a139c28c47c77aaa762d3b39d108a8c49f44dae5dc743b78d2d15628ce01a2f1ec60954dbf9c9272911e48faa8c2fd96d3523c0e1a6a0d0a39df0e9accde9690")
    if result_13 != 0 {
        return 13 * 10 + result_13
    }
    result_14 := check(.CHACHA, "010e1b2835424f5c697683909daab7c4d1deebf805121f2c394653606d7a8794", "000102030405060708090a0b", "", "030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dce3eaf1f8ff060d141b222930373e454c535a61686f767d848b9299a0a7aeb5bcc3", "d338f160103cae6f1fc19d4f76ed4a0c4b8e582c40c1edac8a194e8dc1c412ee519d3edc98b0aa5f91721b6c33d659de1a351bdb3328073f078fdc69e09bceb27ea6a48f3458c8d4c7010f0353f8584972")
    if result_14 != 0 {
        return 14 * 10 + result_14
    }
    result_15 := check(.AES, "010e1b2835424f5c697683909daab7c4d1deebf805121f2c394653606d7a8794", "000102030405060708090a0b", "", "030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dce3eaf1f8ff060d141b222930373e454c535a61686f767d848b9299a0a7aeb5bcc3", "49c966e1514d2e5df41c40e87366f277a139c28c47c77aaa762d3b39d108a8c49f44dae5dc743b78d2d15628ce01a2f1ec60954dbf9c9272911e48faa8c2fd9604d5e561625a53dc78b4330bb261d3cf4e")
    if result_15 != 0 {
        return 15 * 10 + result_15
    }
    result_16 := check(.AES_SOFTWARE, "010e1b2835424f5c697683909daab7c4d1deebf805121f2c394653606d7a8794", "000102030405060708090a0b", "", "030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dce3eaf1f8ff060d141b222930373e454c535a61686f767d848b9299a0a7aeb5bcc3", "49c966e1514d2e5df41c40e87366f277a139c28c47c77aaa762d3b39d108a8c49f44dae5dc743b78d2d15628ce01a2f1ec60954dbf9c9272911e48faa8c2fd9604d5e561625a53dc78b4330bb261d3cf4e")
    if result_16 != 0 {
        return 16 * 10 + result_16
    }
    result_17 := check(.CHACHA, "010e1b2835424f5c697683909daab7c4d1deebf805121f2c394653606d7a8794", "000102030405060708090a0b", "030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dce3", "", "")
    if result_17 != 0 {
        return 17 * 10 + result_17
    }
    result_18 := check(.AES, "010e1b2835424f5c697683909daab7c4d1deebf805121f2c394653606d7a8794", "000102030405060708090a0b", "030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dce3", "", "")
    if result_18 != 0 {
        return 18 * 10 + result_18
    }
    result_19 := check(.AES_SOFTWARE, "010e1b2835424f5c697683909daab7c4d1deebf805121f2c394653606d7a8794", "000102030405060708090a0b", "030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dce3", "", "")
    if result_19 != 0 {
        return 19 * 10 + result_19
    }
    result_20 := check(.CHACHA, "010e1b2835424f5c697683909daab7c4d1deebf805121f2c394653606d7a8794", "000102030405060708090a0b", "030a11181f262d343b424950", "", "")
    if result_20 != 0 {
        return 20 * 10 + result_20
    }
    result_21 := check(.AES, "010e1b2835424f5c697683909daab7c4d1deebf805121f2c394653606d7a8794", "000102030405060708090a0b", "030a11181f262d343b424950", "", "")
    if result_21 != 0 {
        return 21 * 10 + result_21
    }
    result_22 := check(.AES_SOFTWARE, "010e1b2835424f5c697683909daab7c4d1deebf805121f2c394653606d7a8794", "000102030405060708090a0b", "030a11181f262d343b424950", "", "")
    if result_22 != 0 {
        return 22 * 10 + result_22
    }
    result_23 := check(.AES, "feffe9928665731c6d6a8f9467308308feffe9928665731c6d6a8f9467308308", "cafebabefacedbaddecaf888", "feedfacedeadbeeffeedfacedeadbeefabaddad2", "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39", "522dc1f099567d07f47f37a32a84427d643a8cdcbfe5c0c97598a2bd2555d1aa8cb08e48590dbb3da7b08b1056828838c5f61e6393ba7a0abcc9f66276fc6ece0f4e1768cddf8853bb2d551b")
    if result_23 != 0 {
        return 23 * 10 + result_23
    }
    result_24 := check(.AES_SOFTWARE, "feffe9928665731c6d6a8f9467308308feffe9928665731c6d6a8f9467308308", "cafebabefacedbaddecaf888", "feedfacedeadbeeffeedfacedeadbeefabaddad2", "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39", "522dc1f099567d07f47f37a32a84427d643a8cdcbfe5c0c97598a2bd2555d1aa8cb08e48590dbb3da7b08b1056828838c5f61e6393ba7a0abcc9f66276fc6ece0f4e1768cddf8853bb2d551b")
    if result_24 != 0 {
        return 24 * 10 + result_24
    }
    return 42
}
