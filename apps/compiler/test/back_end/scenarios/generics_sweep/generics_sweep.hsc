/*
 * Every generic function and type in base and std, instantiated with typical type arguments (int,
 * string, a struct, a pointer) and values, so --generate-all checks and generates their bodies too:
 * the everything scenarios import this. Nothing here runs.
 */
package generics_sweep

import runtime from "base"
import concurrency from "std"
import containers from "std"
import maps from "std"
import memory from "std"
import os from "std"

Point :: struct {
    x : int,
    y : int,
}

Linked :: struct {
    link : containers.ListLink,
    value : int,
}

// What every instance needs: called by nothing, generated by --generate-all.
instantiate_all :: fn(number: int, point: Point) {
    // What's kept, by #escaping parameters, can't be on the stack
    text :: "sample"
    pointer :: runtime.new(int)
    // builtin
    _ = size_of(Point) + align_of(string) + offset_of(Point, y)
    _ = type_info_of(int)
    _ = max_value(u32)
    _ = min_value(i8)
    _ = view_of(pointer, 1)
    // runtime: allocation
    one :: runtime.new(Point)
    runtime.free(one)
    many, _ :: runtime.new_array(string, 4)
    runtime.free_array(many)
    aligned, _ :: runtime.new_aligned(int, 64)
    runtime.free(aligned)
    // runtime: dynamic arrays of each kind of element
    numbers : int[..]
    runtime.array_reserve(&numbers, 8)
    runtime.array_add(&numbers, number)
    runtime.array_copy(numbers, &numbers)
    _ = runtime.array_find(numbers, number)
    runtime.array_remove(&numbers, 0)
    runtime.array_remove_fast(&numbers, 0)
    _ = runtime.peek(numbers)
    _ = runtime.pop(&numbers)
    runtime.array_reset(&numbers)
    runtime.array_free(&numbers)
    names : string[..]
    runtime.array_add(&names, text)
    _ = runtime.pop(&names)
    runtime.array_free(&names)
    points : Point[..]
    runtime.array_add(&points, point)
    runtime.array_remove(&points, 0)
    runtime.array_free(&points)
    pointers : ptr[mut int][..]
    runtime.array_add(&pointers, pointer)
    _ = runtime.array_find(pointers, pointer)
    runtime.array_free(&pointers)
    // runtime: context extensions
    _ = runtime.get_extension(Point)
    // std/memory
    ok : Result[int, string] = .Ok(number)
    _ = memory.is_ok(ok)
    _ = memory.is_error(ok)
    shared :: runtime.new(memory.SharedPtr[Point])
    memory.increment(shared)
    _ = memory.decrement(shared)
    // std/containers
    fixed : containers.FixedArray[Point, 4]
    _ = containers.fixed_push(&fixed, point)
    _ = containers.fixed_pop(&fixed)
    _ = containers.fixed_remove_swap(&fixed, 0)
    _ = containers.fixed_view(&fixed)
    containers.fixed_clear(&fixed)
    ring : containers.RingBuffer[string, 8]
    _ = containers.ring_push(&ring, text)
    _ = containers.ring_peek(&ring)
    _ = containers.ring_pop(&ring)
    containers.ring_clear(&ring)
    bits : containers.Bitmap[100]
    containers.bit_set(&bits, 3)
    containers.bit_clear(&bits, 3)
    _ = containers.bit_test(&bits, 3)
    _ = containers.bit_find_set(&bits, 0)
    _ = containers.bit_find_clear(&bits, 0)
    _ = containers.bit_count(&bits)
    containers.bit_clear_all(&bits)
    linked :: runtime.new(Linked)
    _ = containers.entry_of[Linked](&linked.link, offset_of(Linked, link))
    // std/concurrency
    channel :: runtime.new(concurrency.Channel[int, 4])
    _ = concurrency.channel_send(channel, number)
    received, open :: concurrency.channel_receive(channel)
    concurrency.channel_close(channel)
    // std/maps
    words : maps.HashMap[string, Point, maps.hash_string]
    maps.map_put(&words, text, point)
    _ = maps.map_get(&words, text)
    _ = maps.map_has(&words, text)
    _ = maps.map_remove(&words, text)
    maps.map_clear(&words)
    maps.map_free(&words)
    numbers_by_number : maps.HashMap[int, int, maps.hash_integer[int]]
    maps.map_put(&numbers_by_number, number, number)
    maps.map_free(&numbers_by_number)
    // std/os
    _ = os.as_result(number, null)
}
