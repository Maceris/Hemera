/*
 * std/crypto against Project Wycheproof's test vectors (github.com/C2SP/wycheproof, testvectors_v1,
 * Apache License 2.0), generated from them: 518 X25519, 139 ED25519, 316 CHACHA, 66 AES, 174 HMAC256, 86 HKDF256, 174 HMAC512, 83 HKDF512.
 * Skipped, as the types can't hold them: 12 Ed25519, signatures not 64 bytes, 9 chacha20_poly1305, sizes the types can't hold, 250 aes_gcm, sizes the types can't hold. main returns 42 if every case did what it should.
 */
package wycheproof_test

import compiler from "base"
import crypto from "std"

BUFFER :: 16384

// hex's bytes into into, how many there were
decode :: fn(hex: string, into: ptr[mut u8[BUFFER]]) -> usize {
    for i in 0..<BUFFER {
        into[i] = 0
    }
    for c, j in hex {
        nibble := cast[u8](c) - cast[u8]('0')
        if c >= 'a' {
            nibble = cast[u8](c) - cast[u8]('a') + 10
        }
        into[(j / 2) % BUFFER] = into[(j / 2) % BUFFER] * 16 + nibble
    }
    return (hex.count / 2) % (BUFFER + 1)
}

number :: fn(text: string) -> usize {
    value : usize = 0
    for c in text {
        value = value * 10 + cast[usize](cast[u8](c) - cast[u8]('0'))
    }
    return value
}

Buffers :: struct {
    a: u8[BUFFER],
    b: u8[BUFFER],
    c: u8[BUFFER],
    d: u8[BUFFER],
    e: u8[BUFFER],
    f: u8[BUFFER],
    secret: crypto.SecretByte[BUFFER],
}

// A shared secret of all zeros is a low-order point's, which x25519 refuses
x25519_case #constant_time :: fn(b: ptr[mut Buffers], private_hex: string, public_hex: string, shared_hex: string) -> bool {
    _ = decode(private_hex, &b.a)
    _ = decode(public_hex, &b.b)
    _ = decode(shared_hex, &b.c)
    secret : crypto.X25519SecretKey
    public : crypto.X25519PublicKey
    expected : u8[32]
    zero := true
    for i in 0..<32 {
        secret[i] = b.a[i]
        public[i] = b.b[i]
        expected[i] = b.c[i]
        zero = zero && expected[i] == 0
    }
    shared : crypto.SecretByte[32]
    worked := crypto.x25519(&secret, &public, &shared)
    return worked != zero && crypto.equal(shared, expected)
}

ed25519_case :: fn(b: ptr[mut Buffers], public_hex: string, message_hex: string, signature_hex: string, valid: bool) -> bool {
    _ = decode(public_hex, &b.a)
    message_count := decode(message_hex, &b.b) % (BUFFER + 1)
    _ = decode(signature_hex, &b.c)
    public : crypto.Ed25519PublicKey
    for i in 0..<32 {
        public[i] = b.a[i]
    }
    signature : crypto.Ed25519Signature
    for i in 0..<64 {
        signature[i] = b.c[i]
    }
    return crypto.ed25519_verify(&public, b.b[0..<message_count], &signature) == valid
}

Aead :: enum {
    CHACHA,
    AES,
    AES_SOFTWARE,
}

/*
 * A valid case seals to the ciphertext and tag and opens again; an invalid one is refused, writing
 * nothing
 */
aead_case #constant_time :: fn(kind: Aead, b: ptr[mut Buffers], key_hex: string, nonce_hex: string, associated_hex: string,
    message_hex: string, ciphertext_hex: string, tag_hex: string, valid: bool) -> bool {

    _ = decode(key_hex, &b.a)
    _ = decode(nonce_hex, &b.b)
    associated_count := decode(associated_hex, &b.c) % (BUFFER + 1)
    message_count := decode(message_hex, &b.d) % (BUFFER + 1)
    ciphertext_count := decode(ciphertext_hex, &b.e) % (BUFFER + 1)
    _ = decode(tag_hex, &b.f)
    key : crypto.Key256
    for i in 0..<32 {
        key[i] = b.a[i]
    }
    nonce : crypto.Nonce96
    for i in 0..<12 {
        nonce[i] = b.b[i]
    }
    tag : crypto.Tag128
    for i in 0..<16 {
        tag[i] = b.f[i]
    }
    hardware := kind == .AES && crypto.aes_hardware()
    if valid {
        sealed : u8[BUFFER]
        sealed_tag : crypto.Tag128
        worked := false
        if kind == .CHACHA {
            worked = crypto.chacha20_poly1305_seal(&key, &nonce, crypto.as_secret(b.d[0..<message_count]), b.c[0..<associated_count],
                sealed[0..<message_count], &sealed_tag)
        }
        else {
            worked = crypto.aes256_gcm_seal_with(&key, &nonce, crypto.as_secret(b.d[0..<message_count]), b.c[0..<associated_count],
                sealed[0..<message_count], &sealed_tag, hardware)
        }
        if !worked || message_count != ciphertext_count {
            return false
        }
        for i in 0..<message_count {
            if sealed[i] != b.e[i] {
                return false
            }
        }
        for i in 0..<16 {
            if sealed_tag[i] != tag[i] {
                return false
            }
        }
    }
    opened : crypto.SecretByte[BUFFER]
    worked := false
    if kind == .CHACHA {
        worked = crypto.chacha20_poly1305_open(&key, &nonce, b.e[0..<ciphertext_count], b.c[0..<associated_count], &tag,
            opened[0..<ciphertext_count])
    }
    else {
        worked = crypto.aes256_gcm_open_with(&key, &nonce, b.e[0..<ciphertext_count], b.c[0..<associated_count], &tag,
            opened[0..<ciphertext_count], hardware)
    }
    if worked != valid {
        return false
    }
    if valid {
        return crypto.equal(opened[0..<ciphertext_count], b.d[0..<message_count])
    }
    // Refused: nothing readable written
    for i in 0..<ciphertext_count {
        if compiler.declassify(opened[i]) != 0 {
            return false
        }
    }
    return true
}

// The tag, maybe truncated, matches for a valid case and not for an invalid one
hmac_case #constant_time :: fn(size: int, b: ptr[mut Buffers], key_hex: string, message_hex: string, tag_hex: string, valid: bool) -> bool {
    key_count := decode(key_hex, &b.a) % (BUFFER + 1)
    message_count := decode(message_hex, &b.b) % (BUFFER + 1)
    tag_count := decode(tag_hex, &b.c) % (BUFFER + 1)
    if size == 256 {
        tag := crypto.hmac_sha256(crypto.as_secret(b.a[0..<key_count]), b.b[0..<message_count])
        return crypto.equal(tag[0..<tag_count % 33], b.c[0..<tag_count]) == valid
    }
    tag := crypto.hmac_sha512(crypto.as_secret(b.a[0..<key_count]), b.b[0..<message_count])
    return crypto.equal(tag[0..<tag_count % 65], b.c[0..<tag_count]) == valid
}

// Extracted and expanded to the expected output, or refused for a size too large
hkdf_case #constant_time :: fn(size: int, b: ptr[mut Buffers], input_hex: string, salt_hex: string, info_hex: string,
    output_size: string, output_hex: string, valid: bool) -> bool {

    input_count := decode(input_hex, &b.a) % (BUFFER + 1)
    salt_count := decode(salt_hex, &b.b) % (BUFFER + 1)
    info_count := decode(info_hex, &b.c) % (BUFFER + 1)
    output_count := decode(output_hex, &b.d) % (BUFFER + 1)
    count := number(output_size) % (BUFFER + 1)
    worked := false
    if size == 256 {
        key := crypto.hkdf_sha256_extract(b.b[0..<salt_count], crypto.as_secret(b.a[0..<input_count]))
        worked = crypto.hkdf_sha256_expand(key, b.c[0..<info_count], b.secret[0..<count])
    }
    else {
        key := crypto.hkdf_sha512_extract(b.b[0..<salt_count], crypto.as_secret(b.a[0..<input_count]))
        worked = crypto.hkdf_sha512_expand(key, b.c[0..<info_count], b.secret[0..<count])
    }
    if !valid {
        return !worked
    }
    return worked && count == output_count && crypto.equal(b.secret[0..<count], b.d[0..<output_count])
}

