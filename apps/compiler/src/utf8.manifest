<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  UTF-8 as the process's code page (Windows 10 1903 and later), so the command line, paths through std::filesystem and
  the C library, and everything else Windows converts through the "ANSI" code page, are UTF-8, as text in the compiler
  is everywhere else.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
