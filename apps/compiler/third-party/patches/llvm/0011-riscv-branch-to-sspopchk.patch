diff --git a/llvm/lib/Target/RISCV/RISCVFeatures.td b/llvm/lib/Target/RISCV/RISCVFeatures.td
--- a/llvm/lib/Target/RISCV/RISCVFeatures.td
+++ b/llvm/lib/Target/RISCV/RISCVFeatures.td
@@ -2036,6 +2036,11 @@ def FeatureExactAssembly
     : SubtargetFeature<"exact-asm", "EnableExactAssembly", "true",
                        "Enable Exact Assembly (Disables Compression and Relaxation)">;
 
+def FeatureBranchToSSPopChk
+    : SubtargetFeature<"branch-to-sspopchk", "BranchToSSPopChk", "true",
+                       "Branch to each epilogue's sspopchk, so an emulator "
+                       "begins a translation block with it">;
+
 foreach i = {1-31} in
   def FeatureReserveX#i :
       SubtargetFeature<"reserve-x"#i, "UserReservedXRegs["#i#"]",
diff --git a/llvm/lib/Target/RISCV/RISCVFrameLowering.cpp b/llvm/lib/Target/RISCV/RISCVFrameLowering.cpp
--- a/llvm/lib/Target/RISCV/RISCVFrameLowering.cpp
+++ b/llvm/lib/Target/RISCV/RISCVFrameLowering.cpp
@@ -26,6 +26,7 @@
 #include "llvm/CodeGen/RegisterScavenging.h"
 #include "llvm/CodeGen/TargetFrameLowering.h"
 #include "llvm/IR/DiagnosticInfo.h"
+#include "llvm/IR/InlineAsm.h"
 #include "llvm/MC/MCDwarf.h"
 #include "llvm/Support/LEB128.h"
 
@@ -166,6 +167,22 @@ static void emitSCSPrologue(MachineFunction &MF, MachineBasicBlock &MBB,
       .buildEscape(StringRef(CFIInst, sizeof(CFIInst)));
 }
 
+// With branch-to-sspopchk, `beq zero, zero, .+4` before a sspopchk: it isn't
+// compressible, so it always reaches the sspopchk just after it, and it ends an
+// emulator's translation block, so the sspopchk begins the next one. QEMU 11.1
+// loses track of the pc after a sspopchk that passes, in the rest of its block,
+// unless the sspopchk is the block's first instruction. It's inline assembly,
+// as a BEQ would be taken for the block's terminator, with the sspopchk after it.
+static void emitBranchToSSPopChk(MachineBasicBlock &MBB,
+                                 MachineBasicBlock::iterator MI,
+                                 const DebugLoc &DL,
+                                 const RISCVInstrInfo *TII) {
+  BuildMI(MBB, MI, DL, TII->get(TargetOpcode::INLINEASM))
+      .addExternalSymbol("beq zero, zero, .+4")
+      .addImm(InlineAsm::Extra_HasSideEffects)
+      .setMIFlag(MachineInstr::FrameDestroy);
+}
+
 static void emitSCSEpilogue(MachineFunction &MF, MachineBasicBlock &MBB,
                             MachineBasicBlock::iterator MI,
                             const DebugLoc &DL) {
@@ -191,6 +208,8 @@ static void emitSCSEpilogue(MachineFunction &MF, MachineBasicBlock &MBB,
     // `sspopchk x5` is the only compressible form, but this would require using
     // `x5` as the return address everywhere, which would also mean reserving
     // it. We prefer to just use `x1` to avoid that complexity.
+    if (STI.branchToSSPopChk())
+      emitBranchToSSPopChk(MBB, MI, DL, TII);
     BuildMI(MBB, MI, DL, TII->get(RISCV::SSPOPCHK))
         .addReg(RAReg)
         .setMIFlag(MachineInstr::FrameDestroy);
diff --git a/llvm/test/CodeGen/RISCV/branch-to-sspopchk.ll b/llvm/test/CodeGen/RISCV/branch-to-sspopchk.ll
new file mode 100644
--- /dev/null
+++ b/llvm/test/CodeGen/RISCV/branch-to-sspopchk.ll
@@ -0,0 +1,31 @@
+; RUN: llc -mtriple=riscv64 -mattr=+c,+zicfiss,+branch-to-sspopchk -verify-machineinstrs < %s | FileCheck %s
+; RUN: llc -mtriple=riscv64 -mattr=+c,+zicfiss -verify-machineinstrs < %s | FileCheck %s --check-prefix=PLAIN
+; RUN: llc -mtriple=riscv64 -mattr=+c,+zicfiss,+branch-to-sspopchk -filetype=obj < %s \
+; RUN:   | llvm-objdump -d --mattr=+c,+zicfiss - | FileCheck %s --check-prefix=OBJECT
+
+; With branch-to-sspopchk, each epilogue's sspopchk is reached by a branch to
+; it, which isn't compressed, so the sspopchk begins an emulator's translation
+; block. The branch is inline assembly, as a BEQ would be the block's
+; terminator, with the sspopchk after it.
+
+declare void @g()
+
+define void @f() "hw-shadow-stack" {
+; CHECK-LABEL: f:
+; CHECK:       sspush ra
+; CHECK:       call g
+; CHECK:       #APP
+; CHECK-NEXT:  [[HERE:.Ltmp[0-9]+]]:
+; CHECK-NEXT:  beq zero, zero, [[HERE]]+4
+; CHECK-NEXT:  #NO_APP
+; CHECK-NEXT:  sspopchk ra
+; CHECK-NEXT:  ret
+; PLAIN-LABEL: f:
+; PLAIN-NOT:   beq
+; PLAIN:       sspopchk ra
+; PLAIN-NEXT:  ret
+; OBJECT:      00000263 beqz zero,
+; OBJECT-NEXT: cdc0c073 sspopchk ra
+  call void @g()
+  ret void
+}
