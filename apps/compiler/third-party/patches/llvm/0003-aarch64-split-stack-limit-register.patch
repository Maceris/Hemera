+// "split-stack" with "split-stack-limit-register"="x28": the stack pointer less
+// the frame is compared against a limit read at an offset
+// ("split-stack-limit-offset", a multiple of 8, default 0) from a register the
+// program reserves for it (+reserve-x28), so any platform works, including
+// freestanding ones. Without room, "split-stack-failure"="trap" runs brk #1, and
+// "split-stack-morestack"="symbol" calls symbol with Hemera's protocol: a frame
+// record, the frame's size in x9, the stack arguments' size in x10, the body's
+// address in x11, and bl symbol, which runs the body on a new stack segment and
+// returns once it has; then back to the caller. x16 and x17, which nothing
+// holds at a function's entry, are the check's scratch registers, and x0 to x8
+// pass through untouched. LLVM has no other segmented stacks on AArch64.
+void AArch64FrameLowering::adjustForSegmentedStacks(
+    MachineFunction &MF, MachineBasicBlock &PrologueMBB) const {
+  const Function &Fn = MF.getFunction();
+  if (!Fn.hasFnAttribute("split-stack-limit-register"))
+    report_fatal_error(
+        "Segmented stacks on AArch64 need split-stack-limit-register");
+  if (Fn.isVarArg())
+    report_fatal_error("Segmented stacks do not support vararg functions.");
+  StringRef Name =
+      Fn.getFnAttribute("split-stack-limit-register").getValueAsString();
+  const Register LimitReg = StringSwitch<unsigned>(Name)
+                                .Case("x27", AArch64::X27)
+                                .Case("x28", AArch64::X28)
+                                .Default(0);
+  if (!LimitReg)
+    report_fatal_error("Unsupported split-stack-limit-register " + Name);
+  int64_t LimitOffset = 0;
+  if (Fn.hasFnAttribute("split-stack-limit-offset") &&
+      Fn.getFnAttribute("split-stack-limit-offset")
+          .getValueAsString()
+          .getAsInteger(0, LimitOffset))
+    report_fatal_error("Invalid split-stack-limit-offset");
+  if (LimitOffset < 0 || LimitOffset % 8 != 0 || LimitOffset / 8 > 4095)
+    report_fatal_error(
+        "split-stack-limit-offset must be a multiple of 8, from 0 to 32760");
+  const bool TrapOnFailure =
+      Fn.getFnAttribute("split-stack-failure").getValueAsString() == "trap";
+  const StringRef MorestackSymbol =
+      Fn.getFnAttribute("split-stack-morestack").getValueAsString();
+  if (!TrapOnFailure && MorestackSymbol.empty())
+    report_fatal_error("Segmented stacks on AArch64 need "
+                       "split-stack-failure=trap or split-stack-morestack");
+
+  MachineFrameInfo &MFI = MF.getFrameInfo();
+  if (!MFI.needsSplitStackProlog())
+    return;
+  const AArch64InstrInfo &TII =
+      *MF.getSubtarget<AArch64Subtarget>().getInstrInfo();
+  const AArch64FunctionInfo *AFI = MF.getInfo<AArch64FunctionInfo>();
+  const uint64_t StackSize = MFI.getStackSize();
+  DebugLoc DL;
+
+  MachineBasicBlock *AllocMBB = MF.CreateMachineBasicBlock();
+  MachineBasicBlock *CheckMBB = MF.CreateMachineBasicBlock();
+  for (const auto &LI : PrologueMBB.liveins()) {
+    AllocMBB->addLiveIn(LI);
+    CheckMBB->addLiveIn(LI);
+  }
+  MF.push_front(AllocMBB);
+  MF.push_front(CheckMBB);
+
+  // x16, the limit; x17, the stack pointer less the frame
+  BuildMI(CheckMBB, DL, TII.get(AArch64::LDRXui), AArch64::X16)
+      .addReg(LimitReg)
+      .addImm(LimitOffset / 8);
+  if (StackSize < 4096) {
+    BuildMI(CheckMBB, DL, TII.get(AArch64::SUBXri), AArch64::X17)
+        .addReg(AArch64::SP)
+        .addImm(StackSize)
+        .addImm(0);
+  } else {
+    BuildMI(CheckMBB, DL, TII.get(AArch64::MOVi64imm), AArch64::X17)
+        .addImm(StackSize);
+    BuildMI(CheckMBB, DL, TII.get(AArch64::SUBXrx64), AArch64::X17)
+        .addReg(AArch64::SP)
+        .addReg(AArch64::X17, RegState::Kill)
+        .addImm(AArch64_AM::getArithExtendImm(AArch64_AM::UXTX, 0));
+  }
+  // Into the function when there's room: above the limit
+  BuildMI(CheckMBB, DL, TII.get(AArch64::SUBSXrr), AArch64::XZR)
+      .addReg(AArch64::X17, RegState::Kill)
+      .addReg(AArch64::X16, RegState::Kill);
+  BuildMI(CheckMBB, DL, TII.get(AArch64::Bcc))
+      .addImm(AArch64CC::HI)
+      .addMBB(&PrologueMBB);
+  CheckMBB->addSuccessor(AllocMBB, BranchProbability::getZero());
+  CheckMBB->addSuccessor(&PrologueMBB, BranchProbability::getOne());
+
+  if (TrapOnFailure) {
+    BuildMI(AllocMBB, DL, TII.get(AArch64::BRK)).addImm(1);
+    return;
+  }
+
+  PrologueMBB.setMachineBlockAddressTaken();
+  PrologueMBB.setLabelMustBeEmitted();
+  BuildMI(AllocMBB, DL, TII.get(AArch64::STPXpre), AArch64::SP)
+      .addReg(AArch64::FP)
+      .addReg(AArch64::LR)
+      .addReg(AArch64::SP)
+      .addImm(-2);
+  BuildMI(AllocMBB, DL, TII.get(AArch64::ADDXri), AArch64::FP)
+      .addReg(AArch64::SP)
+      .addImm(0)
+      .addImm(0);
+  BuildMI(AllocMBB, DL, TII.get(AArch64::MOVi64imm), AArch64::X9)
+      .addImm(StackSize);
+  BuildMI(AllocMBB, DL, TII.get(AArch64::MOVi64imm), AArch64::X10)
+      .addImm(AFI->getBytesInStackArgArea());
+  BuildMI(AllocMBB, DL, TII.get(AArch64::ADR), AArch64::X11)
+      .addMBB(&PrologueMBB);
+  BuildMI(AllocMBB, DL, TII.get(AArch64::BL))
+      .addExternalSymbol(MF.createExternalSymbolName(MorestackSymbol));
+  BuildMI(AllocMBB, DL, TII.get(AArch64::LDPXpost))
+      .addReg(AArch64::SP, RegState::Define)
+      .addReg(AArch64::FP, RegState::Define)
+      .addReg(AArch64::LR, RegState::Define)
+      .addReg(AArch64::SP)
+      .addImm(2);
+  BuildMI(AllocMBB, DL, TII.get(AArch64::RET)).addReg(AArch64::LR);
+}
