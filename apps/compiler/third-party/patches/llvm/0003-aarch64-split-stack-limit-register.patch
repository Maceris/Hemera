diff --git a/llvm/test/CodeGen/AArch64/segmented-stacks-limit-register.ll b/llvm/test/CodeGen/AArch64/segmented-stacks-limit-register.ll
new file mode 100644
index 000000000000..80b789e172c1
--- /dev/null
+++ b/llvm/test/CodeGen/AArch64/segmented-stacks-limit-register.ll
@@ -0,0 +1,72 @@
+; RUN: llc < %s -mtriple=aarch64-unknown-none-elf -mattr=+reserve-x28 -verify-machineinstrs | FileCheck %s
+; RUN: llc < %s -mtriple=aarch64-linux-gnu -mattr=+reserve-x28 -verify-machineinstrs | FileCheck %s
+
+; Segmented stacks on AArch64, with the limit read at an offset from a reserved register,
+; as on X86: running out traps, or calls a symbol with Hemera's protocol. The stack pointer
+; less the frame is compared, whatever the frame's size.
+
+declare void @use(ptr)
+
+define void @big() "split-stack" "split-stack-limit-register"="x28" "split-stack-failure"="trap" {
+; CHECK-LABEL: big:
+; CHECK:       ldr x16, [x28]
+; CHECK-NEXT:  sub x17, sp, #{{[0-9]+}}
+; CHECK-NEXT:  cmp x17, x16
+; CHECK-NEXT:  b.ls [[TRAP:.LBB[0-9_]+]]
+; CHECK:       [[TRAP]]:
+; CHECK-NEXT:  brk #0x1
+  %buf = alloca [1024 x i8]
+  call void @use(ptr %buf)
+  ret void
+}
+
+define void @huge_with_offset() "split-stack" "split-stack-limit-register"="x28" "split-stack-limit-offset"="16" "split-stack-failure"="trap" {
+; CHECK-LABEL: huge_with_offset:
+; CHECK-DAG:   ldr x16, [x28, #16]
+; CHECK-DAG:   mov x17, #{{[0-9]+}}
+; CHECK:       sub x17, sp, x17
+; CHECK-NEXT:  cmp x17, x16
+; CHECK-NEXT:  b.ls
+  %buf = alloca [8192 x i8]
+  call void @use(ptr %buf)
+  ret void
+}
+
+; With "split-stack-morestack": a frame record, the frame size in x9, the stack parameters'
+; size in x10 and the body's address in x11, then bl symbol, and back to the caller.
+define void @grows() "split-stack" "split-stack-limit-register"="x28" "split-stack-morestack"="hemera.morestack" {
+; CHECK-LABEL: grows:
+; CHECK:       ldr x16, [x28]
+; CHECK-NEXT:  sub x17, sp, #{{[0-9]+}}
+; CHECK-NEXT:  cmp x17, x16
+; CHECK-NEXT:  b.ls [[GROW:.LBB[0-9_]+]]
+; CHECK:       [[GROW]]:
+; CHECK-NEXT:  stp x29, x30, [sp, #-16]!
+; CHECK-NEXT:  mov x29, sp
+; CHECK-NEXT:  mov x9, #{{[0-9]+}}
+; CHECK-NEXT:  mov x10, #0
+; CHECK-NEXT:  adr x11, {{.LBB[0-9_]+|.Ltmp[0-9]+}}
+; CHECK-NEXT:  bl hemera.morestack
+; CHECK-NEXT:  ldp x29, x30, [sp], #16
+; CHECK-NEXT:  ret
+  %buf = alloca [1024 x i8]
+  call void @use(ptr %buf)
+  ret void
+}
+
+; No shrink wrapping: the check comes before the early return, not just before the call.
+define void @early_return(ptr %p) "split-stack" "split-stack-limit-register"="x28" "split-stack-failure"="trap" {
+; CHECK-LABEL: early_return:
+; CHECK:       ldr x16, [x28]
+; CHECK-NEXT:  sub x17, sp, #{{[0-9]+}}
+; CHECK-NEXT:  cmp x17, x16
+; CHECK-NEXT:  b.ls
+; CHECK:       cbz x0
+  %null = icmp eq ptr %p, null
+  br i1 %null, label %done, label %call
+call:
+  call void @use(ptr %p)
+  br label %done
+done:
+  ret void
+}
