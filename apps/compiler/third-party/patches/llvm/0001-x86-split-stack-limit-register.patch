+          .addReg(X86::RSP)
+          .addImm(1)
+          .addReg(0)
+          .addImm(-StackSize)
+          .addReg(0);
+
+    BuildMI(checkMBB, DL, TII.get(X86::CMP64rm))
+        .addReg(ScratchReg)
+        .addReg(LimitReg)
+        .addImm(1)
+        .addReg(0)
+        .addImm(LimitOffset)
+        .addReg(0);
