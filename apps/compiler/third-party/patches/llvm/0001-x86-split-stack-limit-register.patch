diff --git a/llvm/test/CodeGen/X86/segmented-stacks-limit-register.ll b/llvm/test/CodeGen/X86/segmented-stacks-limit-register.ll
new file mode 100644
index 000000000000..902249a12112
--- /dev/null
+++ b/llvm/test/CodeGen/X86/segmented-stacks-limit-register.ll
@@ -0,0 +1,62 @@
+; RUN: llc < %s -mtriple=x86_64-unknown-none-elf -mattr=+reserve-r14 -verify-machineinstrs | FileCheck %s
+; RUN: llc < %s -mtriple=x86_64-pc-linux -mattr=+reserve-r14 -verify-machineinstrs | FileCheck %s
+
+; The stack limit is read at an offset from a reserved register, which works on any
+; platform, including freestanding ones, and running out can trap instead of calling
+; __morestack.
+
+declare void @use(ptr)
+
+define void @big() "split-stack" "split-stack-limit-register"="r14" "split-stack-failure"="trap" {
+; CHECK-LABEL: big:
+; CHECK:       leaq -{{[0-9]+}}(%rsp), %r11
+; CHECK-NEXT:  cmpq (%r14), %r11
+; CHECK-NEXT:  jbe [[TRAP:.LBB[0-9_]+]]
+; CHECK:       [[TRAP]]:
+; CHECK-NEXT:  ud2
+; CHECK-NOT:   __morestack
+  %buf = alloca [1024 x i8]
+  call void @use(ptr %buf)
+  ret void
+}
+
+define void @small_with_offset() "split-stack" "split-stack-limit-register"="r14" "split-stack-limit-offset"="16" "split-stack-failure"="trap" {
+; CHECK-LABEL: small_with_offset:
+; CHECK:       cmpq 16(%r14), %rsp
+; CHECK-NEXT:  jbe
+  %buf = alloca [32 x i8]
+  call void @use(ptr %buf)
+  ret void
+}
+
+define void @calls_morestack() "split-stack" "split-stack-limit-register"="r14" {
+; CHECK-LABEL: calls_morestack:
+; CHECK:       cmpq (%r14), %rsp
+; CHECK:       callq __morestack
+  %buf = alloca [32 x i8]
+  call void @use(ptr %buf)
+  ret void
+}
+
+; With "split-stack-morestack", running out calls that symbol with Hemera's protocol:
+; a minimal frame, the frame size in r10, the stack parameters' size in r11 and the
+; body's address in rax.
+define void @grows() "split-stack" "split-stack-limit-register"="r14" "split-stack-morestack"="hemera.morestack" {
+; CHECK-LABEL: grows:
+; CHECK:       leaq -{{[0-9]+}}(%rsp), %r11
+; CHECK-NEXT:  cmpq (%r14), %r11
+; CHECK-NEXT:  jbe [[GROW:.LBB[0-9_]+]]
+; CHECK:       [[GROW]]:
+; CHECK-NEXT:  pushq %rbp
+; CHECK-NEXT:  movq %rsp, %rbp
+; CHECK-NEXT:  movl ${{[0-9]+}}, %r10d
+; CHECK-NEXT:  movl $0, %r11d
+; CHECK-NEXT:  leaq {{.LBB[0-9_]+}}(%rip), %rax
+; CHECK-NEXT:  callq hemera.morestack
+; CHECK-NEXT:  popq %rbp
+; CHECK-NEXT:  retq
+; CHECK-NOT:   __morestack
+  %buf = alloca [1024 x i8]
+  call void @use(ptr %buf)
+  ret void
+}
