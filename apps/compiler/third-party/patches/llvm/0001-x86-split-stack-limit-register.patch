+
+  // "split-stack-limit-register"="r14" reads the stack limit at an offset from a
+  // register the program reserves for it ("split-stack-limit-offset", default
+  // 0), rather than from thread-local storage, so any platform works, including
+  // freestanding ones. "split-stack-failure"="trap" traps when the stack is too
+  // small, rather than calling __morestack.
+  const Function &Fn = MF.getFunction();
+  Register LimitReg;
+  int64_t LimitOffset = 0;
+  if (Fn.hasFnAttribute("split-stack-limit-register")) {
+    StringRef Name =
+        Fn.getFnAttribute("split-stack-limit-register").getValueAsString();
+    LimitReg = StringSwitch<unsigned>(Name)
+                   .Case("r12", X86::R12)
+                   .Case("r13", X86::R13)
+                   .Case("r14", X86::R14)
+                   .Case("r15", X86::R15)
+                   .Default(0);
+    if (!LimitReg || !Is64Bit)
+      report_fatal_error("Unsupported split-stack-limit-register " + Name);
+    if (Fn.hasFnAttribute("split-stack-limit-offset") &&
+        Fn.getFnAttribute("split-stack-limit-offset")
+            .getValueAsString()
+            .getAsInteger(0, LimitOffset))
+      report_fatal_error("Invalid split-stack-limit-offset");
+  }
+  const bool TrapOnFailure =
+      Fn.getFnAttribute("split-stack-failure").getValueAsString() == "trap";
+
+  if (!LimitReg && !STI.isTargetLinux() && !STI.isTargetDarwin() &&
+      !STI.isTargetWin32() && !STI.isTargetWin64() && !STI.isTargetFreeBSD() &&
       !STI.isTargetDragonFly())
     report_fatal_error("Segmented stacks not supported on this platform.");
 
