diff --git a/llvm/test/CodeGen/RISCV/segmented-stacks-limit-register.ll b/llvm/test/CodeGen/RISCV/segmented-stacks-limit-register.ll
new file mode 100644
index 000000000000..1f0153a7d25c
--- /dev/null
+++ b/llvm/test/CodeGen/RISCV/segmented-stacks-limit-register.ll
@@ -0,0 +1,69 @@
+; RUN: llc < %s -mtriple=riscv64-unknown-elf -mattr=+reserve-x27 -verify-machineinstrs | FileCheck %s
+; RUN: llc < %s -mtriple=riscv64-linux-gnu -mattr=+reserve-x27,+c -verify-machineinstrs | FileCheck %s
+; RUN: llc < %s -mtriple=riscv64-unknown-elf -mattr=+reserve-x27 -filetype=obj -o /dev/null
+
+; Segmented stacks on RISC-V, with the limit read at an offset from a reserved register,
+; as on X86 and AArch64: running out traps, or calls a symbol with Hemera's protocol. The
+; stack pointer less the frame is compared, whatever the frame's size.
+
+declare void @use(ptr)
+
+define void @big() "split-stack" "split-stack-limit-register"="x27" "split-stack-failure"="trap" {
+; CHECK-LABEL: big:
+; CHECK:       ld t0, 0(s11)
+; CHECK-NEXT:  addi t1, sp, -1040
+; CHECK-NEXT:  bgeu t0, t1, [[TRAP:.LBB[0-9_]+]]
+; CHECK:       call use
+; CHECK:       [[TRAP]]:
+; CHECK-NEXT:  ebreak
+  %buf = alloca [1024 x i8]
+  call void @use(ptr %buf)
+  ret void
+}
+
+define void @offset() "split-stack" "split-stack-limit-register"="s11" "split-stack-limit-offset"="16" "split-stack-failure"="trap" {
+; CHECK-LABEL: offset:
+; CHECK:       ld t0, 16(s11)
+  %buf = alloca [64 x i8]
+  call void @use(ptr %buf)
+  ret void
+}
+
+define void @huge() "split-stack" "split-stack-limit-register"="x27" "split-stack-failure"="trap" {
+; CHECK-LABEL: huge:
+; CHECK:       ld t0, 0(s11)
+; CHECK:       sub t1, sp, t1
+; CHECK-NEXT:  bgeu t0, t1,
+  %buf = alloca [100000 x i8]
+  call void @use(ptr %buf)
+  ret void
+}
+
+; The body's address, and the frame's and stack arguments' sizes, are what morestack is given
+define i64 @grows(i64 %a, i64 %b, i64 %c, i64 %d, i64 %e, i64 %f, i64 %g, i64 %h, i64 %i) "split-stack" "split-stack-limit-register"="x27" "split-stack-morestack"="hemera.morestack" {
+; CHECK-LABEL: grows:
+; CHECK:       ld t0, 0(s11)
+; CHECK-NEXT:  addi t1, sp, -288
+; CHECK-NEXT:  bgeu t0, t1, [[GROW:.LBB[0-9_]+]]
+; CHECK-NEXT:  [[BODY:.LBB[0-9_]+]]:
+; CHECK:       call use
+; CHECK:       [[GROW]]:
+; CHECK-NEXT:  addi sp, sp, -16
+; CHECK-NEXT:  sd ra, 8(sp)
+; CHECK-NEXT:  sd s0, 0(sp)
+; CHECK-NEXT:  addi s0, sp, 16
+; CHECK-NEXT:  li t3, 288
+; CHECK-NEXT:  li t4, 8
+; CHECK-NEXT:  [[HERE:.Lpcrel_hi[0-9]+]]:
+; CHECK-NEXT:  auipc t5, %pcrel_hi([[BODY]])
+; CHECK-NEXT:  addi t5, t5, %pcrel_lo([[HERE]])
+; CHECK-NEXT:  call hemera.morestack
+; CHECK-NEXT:  ld ra, 8(sp)
+; CHECK-NEXT:  ld s0, 0(sp)
+; CHECK-NEXT:  addi sp, sp, 16
+; CHECK-NEXT:  ret
+  %buf = alloca [256 x i8]
+  call void @use(ptr %buf)
+  %sum = add i64 %a, %i
+  ret i64 %sum
+}
