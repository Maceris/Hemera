+// "split-stack" with "split-stack-limit-register"="x27": the stack pointer less
+// the frame is compared against a limit read at an offset
+// ("split-stack-limit-offset", a multiple of 8, default 0) from a register the
+// program reserves for it (+reserve-x27), so any platform works, including
+// freestanding ones. Without room, "split-stack-failure"="trap" runs ebreak, and
+// "split-stack-morestack"="symbol" calls symbol with Hemera's protocol: a frame
+// record (ra at s0 - 8, the caller's s0 at s0 - 16), the frame's size in t3,
+// the stack arguments' size in t4, the body's address in t5, and call symbol,
+// which runs the body on a new stack segment and returns once it has; then back
+// to the caller. t0 and t1, which nothing holds at a function's entry, are the
+// check's scratch registers; a0 to a7, and t2, Zicfilp's label, pass through
+// untouched. LLVM has no other segmented stacks on RISC-V.
+void RISCVFrameLowering::adjustForSegmentedStacks(
+    MachineFunction &MF, MachineBasicBlock &PrologueMBB) const {
+  const Function &Fn = MF.getFunction();
+  if (!Fn.hasFnAttribute("split-stack-limit-register"))
+    report_fatal_error(
+        "Segmented stacks on RISC-V need split-stack-limit-register");
+  if (Fn.isVarArg())
+    report_fatal_error("Segmented stacks do not support vararg functions.");
+  StringRef Name =
+      Fn.getFnAttribute("split-stack-limit-register").getValueAsString();
+  const Register LimitReg = StringSwitch<unsigned>(Name)
+                                .Case("x27", RISCV::X27)
+                                .Case("s11", RISCV::X27)
+                                .Default(0);
+  if (!LimitReg)
+    report_fatal_error("Unsupported split-stack-limit-register " + Name);
+  int64_t LimitOffset = 0;
+  if (Fn.hasFnAttribute("split-stack-limit-offset") &&
+      Fn.getFnAttribute("split-stack-limit-offset")
+          .getValueAsString()
+          .getAsInteger(0, LimitOffset))
+    report_fatal_error("Invalid split-stack-limit-offset");
+  if (LimitOffset < 0 || LimitOffset % 8 != 0 || LimitOffset > 2040)
+    report_fatal_error(
+        "split-stack-limit-offset must be a multiple of 8, from 0 to 2040");
+  const bool TrapOnFailure =
+      Fn.getFnAttribute("split-stack-failure").getValueAsString() == "trap";
+  const StringRef MorestackSymbol =
+      Fn.getFnAttribute("split-stack-morestack").getValueAsString();
+  if (!TrapOnFailure && MorestackSymbol.empty())
+    report_fatal_error("Segmented stacks on RISC-V need "
+                       "split-stack-failure=trap or split-stack-morestack");
+
+  MachineFrameInfo &MFI = MF.getFrameInfo();
+  if (!MFI.needsSplitStackProlog())
+    return;
+  const RISCVInstrInfo &TII = *STI.getInstrInfo();
+  const auto *RVFI = MF.getInfo<RISCVMachineFunctionInfo>();
+  const uint64_t StackSize = MFI.getStackSize();
+  DebugLoc DL;
+
+  MachineBasicBlock *AllocMBB = MF.CreateMachineBasicBlock();
+  MachineBasicBlock *CheckMBB = MF.CreateMachineBasicBlock();
+  for (const auto &LI : PrologueMBB.liveins()) {
+    AllocMBB->addLiveIn(LI);
+    CheckMBB->addLiveIn(LI);
+  }
+  MF.push_front(AllocMBB);
+  MF.push_front(CheckMBB);
+
+  // t0, the limit; t1, the stack pointer less the frame
+  BuildMI(CheckMBB, DL, TII.get(RISCV::LD), RISCV::X5)
+      .addReg(LimitReg)
+      .addImm(LimitOffset);
+  if (StackSize <= 2048) {
+    BuildMI(CheckMBB, DL, TII.get(RISCV::ADDI), RISCV::X6)
+        .addReg(RISCV::X2)
+        .addImm(-static_cast<int64_t>(StackSize));
+  } else {
+    TII.movImm(*CheckMBB, CheckMBB->end(), DL, RISCV::X6, StackSize);
+    BuildMI(CheckMBB, DL, TII.get(RISCV::SUB), RISCV::X6)
+        .addReg(RISCV::X2)
+        .addReg(RISCV::X6, RegState::Kill);
+  }
+  // Into the function when there's room: above the limit
+  BuildMI(CheckMBB, DL, TII.get(RISCV::BLTU))
+      .addReg(RISCV::X5, RegState::Kill)
+      .addReg(RISCV::X6, RegState::Kill)
+      .addMBB(&PrologueMBB);
+  CheckMBB->addSuccessor(AllocMBB, BranchProbability::getZero());
+  CheckMBB->addSuccessor(&PrologueMBB, BranchProbability::getOne());
+
+  if (TrapOnFailure) {
+    BuildMI(AllocMBB, DL, TII.get(RISCV::EBREAK));
+    return;
+  }
+
+  PrologueMBB.setMachineBlockAddressTaken();
+  PrologueMBB.setLabelMustBeEmitted();
+  BuildMI(AllocMBB, DL, TII.get(RISCV::ADDI), RISCV::X2)
+      .addReg(RISCV::X2)
+      .addImm(-16);
+  BuildMI(AllocMBB, DL, TII.get(RISCV::SD))
+      .addReg(RISCV::X1)
+      .addReg(RISCV::X2)
+      .addImm(8);
+  BuildMI(AllocMBB, DL, TII.get(RISCV::SD))
+      .addReg(RISCV::X8)
+      .addReg(RISCV::X2)
+      .addImm(0);
+  BuildMI(AllocMBB, DL, TII.get(RISCV::ADDI), RISCV::X8)
+      .addReg(RISCV::X2)
+      .addImm(16);
+  TII.movImm(*AllocMBB, AllocMBB->end(), DL, RISCV::X28, StackSize);
+  TII.movImm(*AllocMBB, AllocMBB->end(), DL, RISCV::X29,
+             RVFI->getArgumentStackSize());
+  // t5, the body's address: auipc and addi, the addi naming the auipc
+  MCSymbol *Here = MF.getContext().createNamedTempSymbol("pcrel_hi");
+  MachineInstr *High =
+      BuildMI(AllocMBB, DL, TII.get(RISCV::AUIPC), RISCV::X30)
+          .addSym(PrologueMBB.getSymbol(), RISCVII::MO_PCREL_HI);
+  High->setPreInstrSymbol(MF, Here);
+  BuildMI(AllocMBB, DL, TII.get(RISCV::ADDI), RISCV::X30)
+      .addReg(RISCV::X30)
+      .addSym(Here, RISCVII::MO_PCREL_LO);
+  BuildMI(AllocMBB, DL, TII.get(RISCV::PseudoCALL))
+      .addExternalSymbol(MF.createExternalSymbolName(MorestackSymbol),
+                         RISCVII::MO_CALL)
+      .addReg(RISCV::X1, RegState::ImplicitDefine);
+  BuildMI(AllocMBB, DL, TII.get(RISCV::LD), RISCV::X1)
+      .addReg(RISCV::X2)
+      .addImm(8);
+  BuildMI(AllocMBB, DL, TII.get(RISCV::LD), RISCV::X8)
+      .addReg(RISCV::X2)
+      .addImm(0);
+  BuildMI(AllocMBB, DL, TII.get(RISCV::ADDI), RISCV::X2)
+      .addReg(RISCV::X2)
+      .addImm(16);
+  BuildMI(AllocMBB, DL, TII.get(RISCV::PseudoRET));
+}
