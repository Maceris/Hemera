   }
 
+  // A landing pad after every call, for code that's re-entered at a call's
+  // continuation by an indirect branch, as a resumed fiber is (Hemera)
+  if (F.hasFnAttribute("landing-pads-after-calls")) {
+    const AArch64InstrInfo *TII = Subtarget->getInstrInfo();
+    for (MachineBasicBlock &MBB : MF) {
+      for (auto I = MBB.begin(); I != MBB.end(); ++I) {
+        if (I->isCall() && !I->isReturn()) {
+          BuildMI(MBB, std::next(I), I->getDebugLoc(), TII->get(AArch64::HINT))
+              .addImm(getBTIHintNum(false, true));
+          MadeChange = true;
+        }
+      }
+    }
+  }
