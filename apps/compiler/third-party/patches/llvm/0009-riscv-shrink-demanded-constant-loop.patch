diff --git a/llvm/test/CodeGen/RISCV/shrink-demanded-constant-no-loop.ll b/llvm/test/CodeGen/RISCV/shrink-demanded-constant-no-loop.ll
new file mode 100644
index 000000000000..4f682ea71ca5
--- /dev/null
+++ b/llvm/test/CodeGen/RISCV/shrink-demanded-constant-no-loop.ll
@@ -0,0 +1,23 @@
+; RUN: llc -mtriple=riscv64 -mattr=+zba < %s | FileCheck %s
+; RUN: llc -mtriple=riscv64 -mattr=+zbs < %s | FileCheck %s
+; RUN: llc -mtriple=riscv64 -mattr=+zba,+zbs -O0 < %s | FileCheck %s
+
+; An AND's mask that two uses shrink with different demanded bits: one chooses
+; the constant with its low half duplicated into its high, 0x7fffffff7fffffff,
+; as cheaper than 0x7fffffff0000ff00; the other finds it no cheaper than
+; 0x7fffffff7fffff00, and must keep it rather than shrink it back, or the two
+; undo each other forever.
+
+define i64 @f(i8 %c, i64 %a) {
+; CHECK-LABEL: f:
+; CHECK:       ret
+  %1 = shl i64 %a, 24
+  %2 = zext i8 %c to i64
+  %3 = or i64 %1, %2
+  %4 = shl i64 %3, 8
+  %masked = and i64 %4, 9223372034690580224
+  %5 = or i64 %masked, %a
+  %6 = add i64 %5, 1
+  %7 = lshr i64 %6, 1
+  ret i64 %7
+}
