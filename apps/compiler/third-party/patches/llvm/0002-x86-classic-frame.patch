diff --git a/llvm/test/CodeGen/X86/win64-classic-frame.ll b/llvm/test/CodeGen/X86/win64-classic-frame.ll
new file mode 100644
index 000000000000..f5bd1864cffd
--- /dev/null
+++ b/llvm/test/CodeGen/X86/win64-classic-frame.ll
@@ -0,0 +1,54 @@
+; RUN: llc < %s -mtriple=x86_64-pc-windows-msvc -verify-machineinstrs | FileCheck %s
+
+; "classic-frame" gives a function on Windows the prologue other targets have,
+; with the frame pointer pointing at the saved one whatever the frame's size,
+; and no unwind information.
+
+declare void @use(ptr)
+
+define void @big() "classic-frame" "frame-pointer"="all" {
+; CHECK-LABEL: big:
+; CHECK-NOT:   .seh_
+; CHECK:       pushq %rbp
+; CHECK-NEXT:  movq %rsp, %rbp
+; CHECK-NEXT:  subq ${{[0-9]+}}, %rsp
+; CHECK-NOT:   .seh_
+; CHECK:       popq %rbp
+; CHECK-NEXT:  retq
+  %buf = alloca [1024 x i8]
+  call void @use(ptr %buf)
+  ret void
+}
+
+; llvm.frameaddress is the frame pointer, which points at the caller's.
+define ptr @frame() "classic-frame" "frame-pointer"="all" {
+; CHECK-LABEL: frame:
+; CHECK:       pushq %rbp
+; CHECK-NEXT:  movq %rsp, %rbp
+; CHECK-NEXT:  movq %rbp, %rax
+; CHECK-NEXT:  popq %rbp
+; CHECK-NEXT:  retq
+  %f = call ptr @llvm.frameaddress.p0(i32 0)
+  ret ptr %f
+}
+
+; With the System V convention, xmm6 to xmm15 aren't saved.
+define x86_64_sysvcc void @sysv() "classic-frame" "frame-pointer"="all" {
+; CHECK-LABEL: sysv:
+; CHECK-NOT:   movaps %xmm
+; CHECK:       retq
+  call void asm sideeffect "", "~{xmm6},~{xmm7}"()
+  ret void
+}
+
+; Windows' own convention still saves them.
+define void @win64() "classic-frame" "frame-pointer"="all" {
+; CHECK-LABEL: win64:
+; CHECK:       pushq %rbp
+; CHECK-NEXT:  movq %rsp, %rbp
+; CHECK:       movaps %xmm{{[67]}}
+; CHECK-NOT:   .seh_
+; CHECK:       retq
+  call void asm sideeffect "", "~{xmm6},~{xmm7}"()
+  ret void
+}
