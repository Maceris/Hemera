+/// Return true if we need to use the restricted Windows x64 prologue and
+/// epilogue code patterns that can be described with WinCFI (.seh_*
+/// directives). A function with "classic-frame" doesn't: it gets the prologue
+/// other targets do, with the frame pointer pointing at the saved one, and no
+/// unwind information, so Windows' unwinder can't step through it.
+bool X86FrameLowering::isWin64Prologue(const MachineFunction &MF) const {
+  return MF.usesWindowsUnwindInfo() &&
+         !MF.getFunction().hasFnAttribute("classic-frame");
+}
